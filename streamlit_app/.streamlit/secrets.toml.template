# Streamlit Secrets Template
# Copy this to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to git!

# Google AI API Key (Required)
GOOGLE_API_KEY = "your-google-api-key-here"

# Database Connection (Required)
DATABASE_URL = "postgresql://username:password@host:port/database"

# Optional: Database Pool Settings
DB_POOL_MIN_CONN = "1"
DB_POOL_MAX_CONN = "20"

# Optional: Gemini Model Selection
GEMINI_MODEL = "gemini-2.5-flash-preview-09-2025"

# Optional: Directory Paths (defaults work for most cases)
FILES_DIR = "./related_files"
OUTPUT_DIR = "./output"
RESULTS_DIR = "./results"
